# OCR v7 后台服务环境文件模板
#
# 用法：
#   sudo mkdir -p /etc/ocr-v7
#   sudo cp deploy/ocr-daemon.env.example /etc/ocr-v7/ocr-daemon.env
#   sudo chmod 600 /etc/ocr-v7/ocr-daemon.env   # 里面有明文密钥，必须收紧权限
#   sudo vi /etc/ocr-v7/ocr-daemon.env
#
# 注意：systemd 的 EnvironmentFile 不做变量展开，值里不要写 ${OTHER_VAR}。

# ---------------------------------------------------------------------------
# 一、批次目录
# ---------------------------------------------------------------------------
# 收件根目录：其下每个子目录算一个批次，批次下是 product_id 目录（内含图片）。
OCR_INPUT_ROOT=/data/ocr/inbox

# 数据库平台标识（京东 jd / 天猫 tmall ...）。
OCR_DEMO_PLATFORM=jd

# 安全闸门：确认此前在截图和 KNIME 脚本中泄露的阿里 DashScope Key 已在
# 阿里云控制台吊销并轮换。后台服务不会替你填这一项，必须显式写 YES。
OCR_DEMO_KEYS_ROTATED=YES

# ---------------------------------------------------------------------------
# 二、内网 OCR 服务
# ---------------------------------------------------------------------------
PADDLE_OCR_API_URL=http://192.168.1.115:8870/v1/ocr
PADDLE_OCR_MODEL_VERSION=PaddleOCR-VL-1.6
# 后台并发：单机建议 1；确认 vLLM 有 GPU 余量再调到 2。
OCR_WORKERS=1
# 单个批次块最多几个商品。500 表示「一次收 500 个商品就一次跑完，出一个结果文件」；
# 调小（如 100）会切成多块顺序跑，每块一个 result.csv/xlsx，失败影响面更小、更好重跑。
OCR_CHUNK_SIZE=500
# 批次静置阈值（秒）。批次内只要还有文件在这个时间内被写过，就跳过本轮不开跑。
# 用途：Xftp / sftp / rsync 传 1 万个商品是渐进的，守护进程如果扫到「半批」
# 就开跑，会产出一个只有前几十个商品的 result.csv，还发一封「批次成功」的邮件。
# 默认 300 秒（5 分钟）。传完就不用等了；嫌启动慢可以设 60，设 0 关闭。
OCR_SETTLE_SECONDS=300

# ---------------------------------------------------------------------------
# 三、阿里 DashScope（Qwen 结构化提取 + 联网搜索）
# ---------------------------------------------------------------------------
DASHSCOPE_API_KEY=请替换为已轮换的密钥
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------------------------------------------------------------------------
# 四、PostgreSQL（只读账号）
# ---------------------------------------------------------------------------
POSTGRES_HOST=192.168.0.23
POSTGRES_PORT=5432
POSTGRES_DATABASE=workdb
POSTGRES_USER=workuser
POSTGRES_PASSWORD=请替换为只读账号密码
POSTGRES_SCHEMA=workdb
POSTGRES_SSLMODE=disable

# ---------------------------------------------------------------------------
# 五、邮件报警
# ---------------------------------------------------------------------------
# 默认收件人就是 13306032298@163.com，需要改就取消下面这行注释。
# ALERT_MAIL_TO=13306032298@163.com

ALERT_MAIL_ENABLED=1
ALERT_SMTP_HOST=smtp.163.com
ALERT_SMTP_PORT=465
ALERT_SMTP_SSL=1
# 建议用一个 163 邮箱做发件人；ALERT_SMTP_PASSWORD 填「授权码」，不是登录密码。
ALERT_SMTP_USER=your_sender@163.com
ALERT_SMTP_PASSWORD=请替换为163邮箱授权码
# ALERT_MAIL_FROM=your_sender@163.com
ALERT_MAIL_SUBJECT_PREFIX=[OCR-V7]
# 运行成功时也发一封汇总邮件；只想收告警就改成 0。
ALERT_ON_SUCCESS=1
# 是否随邮件附带 performance.json 和 待复核图片.json。
ALERT_ATTACH_ARTIFACTS=1

# ---------------------------------------------------------------------------
# 六、异常告警（哪几种情况会发邮件）
# ---------------------------------------------------------------------------
# 内网 OCR 服务的固定停机窗口（多个用逗号分隔，支持跨零点如 23:30-01:00）。
# 窗口内探活失败不算故障、不发告警，避免每天收到两封无意义邮件。
# 本环境 OCR 服务每天 14:00 关、18:00 开，所以这里是 14:00-18:00。
ALERT_OCR_MAINTENANCE_WINDOWS=14:00-18:00
# OCR 探活间隔（秒）与「连续失败几次才告警」。
OCR_PROBE_INTERVAL=600
OCR_PROBE_FAILURES=2
# 服务持续不可达时，隔多久再提醒一次（秒）。
OCR_PROBE_REPEAT=3600
# 批次连续多少分钟没有任何进度输出就发一次「疑似卡住」告警。
OCR_STUCK_MINUTES=30
# 一个商品核心字段里至少要有几个非空值，才算「识别出来了」；默认 1。
ALERT_EMPTY_PRODUCT_MIN_FIELDS=1
