{
  "version": "2.0.0",
  "template_id": "knime-health-product-v2",
  "model": {
    "name": "qwen-plus",
    "temperature": 0.3,
    "max_tokens": 2000,
    "system_prompt": "你是一位专业的电商营养健康品类运营分析师。\n根据商品名称和OCR识别文本，输出一个严格的JSON对象，字段如下（不要输出任何其他内容，只输出JSON）：\n{\n  \"guige\": \"产品规格：优先从商品名称中提取明确写出的规格（如60粒/瓶、30条/盒），商品名称无则从OCR文本提取，两处均无明确规格文字则填null，不得推断\",\n  \"guige_zong_liang\": 规格总量数字（从guige字段解析，如60粒/瓶则为60；guige为null或无法解析则填null，不得推算）,\n  \"is_multi_spec\": true或false（文本中明确出现多件/多盒/多瓶捆绑销售标识则为true，单件或无明确捆绑标识则为false）,\n  \"ri_fu_liang\": \"文本中明确写出的日服用量原文（如每日2粒、每天1-2条），文本中无明确用量说明则填null，不得推断\",\n  \"min_ri_fu_liang\": 最小日服量数字（仅从ri_fu_liang解析，如每日1-2粒则为1，每日2粒则为2；ri_fu_liang为null则填null）,\n  \"max_ri_fu_liang\": 最大日服量数字（仅从ri_fu_liang解析，如每日1-2粒则为2，每日2粒则为2；ri_fu_liang为null则填null）,\n  \"ingredients\": \"文本中明确列出的成分，用顿号分隔；无明确成分列表则填null，不得推断\",\n  \"renqun\": \"目标人群，找不到填null\",\n  \"gongneng\": \"主要功能/功效，用顿号分隔，找不到填null\",\n  \"core_audiences\": [\"主要核心人群1\", \"主要核心人群2\"],\n  \"age_focus\": \"偏XX-XX岁\",\n  \"gender_tendency\": \"female_preferred|male_preferred|neutral\",\n  \"pain_points\": [\"痛点1\", \"痛点2\"],\n  \"motivations\": [\"购买动机1\", \"购买动机2\"],\n  \"scenarios\": [\"使用场景1\", \"使用场景2\"],\n  \"concerns_and_barriers\": [\"顾虑/障碍1\", \"顾虑/障碍2\"],\n  \"tone_and_positioning\": \"品牌定位与语气描述\",\n  \"marketing_hooks\": [\"营销亮点1\", \"营销亮点2\"],\n  \"notes\": \"OCR识别质量备注与合规风险提示\",\n  \"marketing_crowd\": \"一句话精准描述目标消费人群\",\n  \"push_title\": \"吸引人的推送标题（20字以内，突出核心卖点）\",\n  \"main_selling_points\": \"主打卖点（多条用；分隔）\",\n  \"push_time\": \"推荐推送时间段及依据\",\n  \"brand\": \"品牌名称，从OCR文本中明确出现的品牌名称提取，找不到填null，不得推断\",\n  \"dosage_form\": \"剂型（如软胶囊、片剂、粉剂、口服液等），从OCR文本中明确出现的剂型提取，找不到填null，不得推断\",\n  \"blue_hat\": \"蓝帽标识/保健食品批准文号，从OCR文本中明确出现的批准文号或蓝帽标识提取，找不到填null，不得推断\",\n  \"factory_name\": \"代工厂/生产企业名称，仅从OCR文本明确写出的内容提取；不得使用商品名、数据库属性或常识推断，找不到填null\",\n  \"factory_address\": \"代工厂/生产企业地址，仅从OCR文本明确写出的内容提取；不得推断，找不到填null\",\n  \"production_license\": \"生产许可证或SC编号，仅从OCR文本明确写出的内容提取；不得推断，找不到填null\",\n  \"origin\": \"产地/原产地，仅从OCR文本明确写出的内容提取；不得推断，找不到填null\",\n  \"ingredient_content\": \"成分及其含量，格式如'GABA 200mg、维生素C 500mg'，从OCR文本中提取明确写出的成分名称及对应含量，找不到填null，不得推断\",\n  \"applicable_crowd\": \"适用人群（从OCR文本或属性中明确提取，如中老年人、孕妇、儿童等），找不到填null，不得推断\"\n}",
    "user_prompt_template": "商品名称：{name}\n\n【提示】规格字段请优先从商品名称中提取（商品名称常含有如\"60粒/瓶\"、\"30条*3盒\"等规格信息）。\n\n以下是该商品多张图片的OCR识别文本（部分可能有识别错误）：\n{ocr_text}\n\n以下是该商品在平台登记的结构化属性（可辅助其他字段）：\n{attributes}\n\n请基于以上所有信息，输出符合要求的JSON。\n\n【重要提醒】factory_name、factory_address、production_license、origin 四个字段只能从OCR识别文本中的明确内容提取，禁止从商品名称、属性或常识补全；OCR没有就填null。程序会在模型返回后确定性地用数据库属性和带URL的联网搜索做回退。\n\n【合规提醒】特殊医学用途配方食品不得称为“蓝帽”，应使用“特医注册”或“小蓝花”。",
    "fields": [
      { "name": "guige", "type": "string", "nullable": true },
      { "name": "guige_zong_liang", "type": "number", "nullable": true, "minimum": 0 },
      { "name": "is_multi_spec", "type": "boolean", "nullable": false },
      { "name": "ri_fu_liang", "type": "string", "nullable": true },
      { "name": "min_ri_fu_liang", "type": "number", "nullable": true, "minimum": 0 },
      { "name": "max_ri_fu_liang", "type": "number", "nullable": true, "minimum": 0 },
      { "name": "ingredients", "type": "string", "nullable": true },
      { "name": "renqun", "type": "string", "nullable": true },
      { "name": "gongneng", "type": "string", "nullable": true },
      { "name": "core_audiences", "type": "array", "items_type": "string", "nullable": true },
      { "name": "age_focus", "type": "string", "nullable": true },
      { "name": "gender_tendency", "type": "string", "nullable": false, "enum": ["female_preferred", "male_preferred", "neutral"] },
      { "name": "pain_points", "type": "array", "items_type": "string", "nullable": true },
      { "name": "motivations", "type": "array", "items_type": "string", "nullable": true },
      { "name": "scenarios", "type": "array", "items_type": "string", "nullable": true },
      { "name": "concerns_and_barriers", "type": "array", "items_type": "string", "nullable": true },
      { "name": "tone_and_positioning", "type": "string", "nullable": true },
      { "name": "marketing_hooks", "type": "array", "items_type": "string", "nullable": true },
      { "name": "notes", "type": "string", "nullable": true },
      { "name": "marketing_crowd", "type": "string", "nullable": true },
      { "name": "push_title", "type": "string", "nullable": true, "max_length": 20 },
      { "name": "main_selling_points", "type": "string", "nullable": true },
      { "name": "push_time", "type": "string", "nullable": true },
      { "name": "brand", "type": "string", "nullable": true },
      { "name": "dosage_form", "type": "string", "nullable": true },
      { "name": "blue_hat", "type": "string", "nullable": true },
      { "name": "factory_name", "type": "string", "nullable": true },
      { "name": "factory_address", "type": "string", "nullable": true },
      { "name": "production_license", "type": "string", "nullable": true },
      { "name": "origin", "type": "string", "nullable": true },
      { "name": "ingredient_content", "type": "string", "nullable": true },
      { "name": "applicable_crowd", "type": "string", "nullable": true }
    ]
  },
  "search": {
    "enabled": true,
    "model": "qwen-plus",
    "temperature": 0.3,
    "max_tokens": 1000,
    "cache_ttl_hours": 24,
    "system_prompt": "你是一位专业的商品信息研究员，可以通过联网搜索获取信息。\n根据商品名称，联网搜索以下信息，输出一个严格的JSON对象（不要输出任何其他内容，只输出JSON）：\n{\n  \"factory_name\": \"代工厂/生产方名称（搜索该品牌或产品的代工厂、生产方信息），找不到填null\",\n  \"factory_address\": \"代工厂/生产方地址，找不到填null\",\n  \"production_license\": \"生产许可证SC编号，找不到填null\",\n  \"origin\": \"产地，找不到填null\",\n  \"hot_topics\": \"与该商品相关的近期热门话题、热搜或舆论趋势，用顿号分隔，找不到填null\"\n}",
    "user_prompt_template": "商品名称：{name}\n\n请联网搜索该商品的代工厂/生产方信息和相关热门话题，输出符合要求的JSON。",
    "fields": [
      { "name": "factory_name", "type": "string", "nullable": true },
      { "name": "factory_address", "type": "string", "nullable": true },
      { "name": "production_license", "type": "string", "nullable": true },
      { "name": "origin", "type": "string", "nullable": true },
      { "name": "hot_topics", "type": "string", "nullable": true }
    ]
  },
  "source_policy": {
    "identity_key": ["platform", "product_id"],
    "protected_from_model": ["platform", "product_id", "价格"],
    "attribute_precedence": {
      "品牌": ["attributes.品牌", "model.brand"],
      "剂型": ["attributes.剂型", "model.dosage_form"],
      "蓝帽标识": ["attributes.蓝帽标识", "model.blue_hat"]
    },
    "enrichment_precedence": ["model.ocr_explicit", "attributes.alias_match", "search.with_provider_url"]
  },
  "platform_column": {
    "name": "platform",
    "type": "string",
    "nullable": false,
    "sources": ["identity.platform"],
    "strategy": "fixed",
    "protected": true
  },
  "output_columns": [
    { "name": "product_id", "type": "string", "nullable": false, "sources": ["identity.product_id"], "strategy": "fixed", "protected": true },
    { "name": "商品名称", "type": "string", "nullable": true, "sources": ["database.product_name.value"], "strategy": "fixed" },
    { "name": "价格", "type": "decimal", "nullable": true, "sources": ["database.price.value"], "strategy": "fixed", "protected": true },
    { "name": "规格", "type": "string", "nullable": true, "sources": ["derived.parse_guige(model.guige).main_spec"], "strategy": "derived" },
    { "name": "包装", "type": "string", "nullable": true, "sources": ["derived.parse_guige(model.guige).package"], "strategy": "derived" },
    { "name": "规格总量", "type": "number", "nullable": true, "sources": ["derived.parse_guige(model.guige).total", "model.guige_zong_liang"], "strategy": "first_non_null" },
    { "name": "最小单位价格", "type": "decimal", "nullable": true, "sources": ["derived.divide(database.price.value,resolved.规格总量)"], "strategy": "derived" },
    { "name": "是否多规格", "type": "boolean", "nullable": false, "sources": ["model.is_multi_spec"], "strategy": "direct" },
    { "name": "日服量", "type": "string", "nullable": true, "sources": ["model.ri_fu_liang"], "strategy": "direct" },
    { "name": "最小日服量", "type": "number", "nullable": true, "sources": ["model.min_ri_fu_liang"], "strategy": "direct" },
    { "name": "最大日服量", "type": "number", "nullable": true, "sources": ["model.max_ri_fu_liang"], "strategy": "direct" },
    { "name": "最小日服成本", "type": "decimal", "nullable": true, "sources": ["derived.daily_cost(database.price.value,resolved.规格总量,model.min_ri_fu_liang)"], "strategy": "derived" },
    { "name": "最大日服成本", "type": "decimal", "nullable": true, "sources": ["derived.daily_cost(database.price.value,resolved.规格总量,model.max_ri_fu_liang)"], "strategy": "derived" },
    { "name": "成分", "type": "string", "nullable": true, "sources": ["model.ingredients"], "strategy": "direct" },
    { "name": "人群", "type": "string", "nullable": true, "sources": ["model.renqun", "model.marketing_crowd"], "strategy": "first_non_empty" },
    { "name": "功能", "type": "string", "nullable": true, "sources": ["model.gongneng"], "strategy": "direct" },
    { "name": "推送标题", "type": "string", "nullable": true, "sources": ["model.push_title"], "strategy": "direct" },
    { "name": "主打卖点", "type": "string", "nullable": true, "sources": ["model.main_selling_points"], "strategy": "direct" },
    { "name": "推送时间", "type": "string", "nullable": true, "sources": ["model.push_time"], "strategy": "direct" },
    { "name": "品牌", "type": "string", "nullable": true, "sources": ["attributes.品牌", "model.brand"], "strategy": "first_non_empty" },
    { "name": "剂型", "type": "string", "nullable": true, "sources": ["attributes.剂型", "model.dosage_form"], "strategy": "first_non_empty" },
    { "name": "蓝帽标识", "type": "string", "nullable": true, "sources": ["attributes.蓝帽标识", "model.blue_hat"], "strategy": "first_non_empty" },
    { "name": "代工厂", "type": "string", "nullable": true, "sources": ["model.factory_name", "attributes.alias_match", "search.factory_name"], "strategy": "first_non_empty" },
    { "name": "代工厂地址", "type": "string", "nullable": true, "sources": ["model.factory_address", "attributes.alias_match", "search.factory_address"], "strategy": "first_non_empty" },
    { "name": "生产许可证", "type": "string", "nullable": true, "sources": ["model.production_license", "attributes.alias_match", "search.production_license"], "strategy": "first_non_empty" },
    { "name": "产地", "type": "string", "nullable": true, "sources": ["model.origin", "attributes.alias_match", "search.origin"], "strategy": "first_non_empty" },
    { "name": "热门话题", "type": "string", "nullable": true, "sources": ["search.hot_topics"], "strategy": "direct" },
    { "name": "成分含量", "type": "string", "nullable": true, "sources": ["model.ingredient_content"], "strategy": "direct" },
    { "name": "适用人群", "type": "string", "nullable": true, "sources": ["model.applicable_crowd", "model.renqun"], "strategy": "first_non_empty" },
    { "name": "所有SKU", "type": "string", "nullable": true, "sources": ["input.all_skus"], "strategy": "distinct_join" },
    { "name": "SKU数量", "type": "integer", "nullable": true, "sources": ["derived.count(input.all_skus)"], "strategy": "derived" },
    { "name": "上架时间", "type": "datetime", "nullable": true, "sources": ["input.first_shelf_time"], "strategy": "earliest" },
    { "name": "persona_json", "type": "string", "nullable": true, "sources": ["model.raw_json"], "strategy": "json_serialize" },
    { "name": "persona_error", "type": "string", "nullable": true, "sources": ["model.error"], "strategy": "direct" }
  ]
}
